# Copie este arquivo para .env e preencha com os seus valores locais.
# O .env não vai para o Git (está no .gitignore).
# Linhas comentadas (#) usam o valor padrão; tire o # só para mudar.
# Atenção: uma variável vazia (ex.: DB_URL=) substitui o padrão por vazio.

# ---------- Banco de dados ----------
# Senha do usuário do seu PostgreSQL local
DB_PASSWORD_COLETAE=
# DB_USUARIO_COLETAE=postgres
# DB_URL=jdbc:postgresql://localhost:5432/coletae_db

# ---------- Painel master ----------
# Senha do painel master (vazia = login master desativado)
SENHA_MASTER=

# ---------- E-mail ----------
# Senha de app do Gmail da conta que envia (opcional, só para envio de e-mail)
SENHA_EMAIL_COLETAE=
# Conta do Gmail que envia os e-mails
# EMAIL_COLETAE=contatocoletae@gmail.com
# Quem recebe os chamados de suporte (em testes, use o seu e-mail)
# EMAIL_SUPORTE=contatocoletae@gmail.com

# ---------- Servidor ----------
# PORT=8080
